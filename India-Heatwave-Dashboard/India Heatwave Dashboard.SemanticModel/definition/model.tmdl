model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Functions

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","fnCleanCity","WeatherData","City","Date"]

annotation PBI_ProTooling = ["DevMode"]

ref table WeatherData
ref table City
ref table Date
ref table 'Temp Increase'

ref role 'North Region Analyst'
ref role 'Coastal Region Analyst'

ref cultureInfo en-US


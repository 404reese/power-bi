	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 047e93b1-aa19-5b1b-80c2-d043d03cc66b
		summarizeBy: none
		sourceColumn: Month Start

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	/// IMD season.
	column Season =
			SWITCH (
			    MONTH ( 'Date'[Date] ),
			    3, "Pre-Monsoon", 4, "Pre-Monsoon", 5, "Pre-Monsoon",
			    6, "Monsoon", 7, "Monsoon", 8, "Monsoon", 9, "Monsoon",
			    10, "Post-Monsoon", 11, "Post-Monsoon",
			    12, "Winter", 1, "Winter", 2, "Winter"
			)
		lineageTag: 37a5f9c6-a45a-5a58-87be-bfe8062e4f83
		summarizeBy: none
		sortByColumn: 'Season Order'

		annotation SummarizationSetBy = User

	column 'Season Order' =
			SWITCH (
			    MONTH ( 'Date'[Date] ),
			    12, 1, 1, 1, 2, 1,
			    3, 2, 4, 2, 5, 2,
			    6, 3, 7, 3, 8, 3, 9, 3,
			    10, 4, 11, 4
			)
		isHidden
		formatString: 0
		lineageTag: d1ee3162-8367-5746-aba1-cff63a12f1ab
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Yes for calendar years fully covered by the data (the last year, 2024, is partial).
	column 'Complete Year' = IF ( 'Date'[Year] < YEAR ( MAX ( 'WeatherData'[Date] ) ), "Yes", "No" )
		lineageTag: b53420d1-7f9b-5734-a73e-ce3e9b716d40
		summarizeBy: none

		annotation SummarizationSetBy = User

	hierarchy 'Date Hierarchy'
		lineageTag: e11ef05a-3125-5aa9-b507-b078b128693d

		level Decade
			lineageTag: a380d1f1-bd5b-503d-92ff-a735eb3a5dd6
			column: Decade

		level Year
			lineageTag: 76cd60a2-11c7-52da-82de-d34be6fa4d14
			column: Year

		level Month
			lineageTag: 7c41230f-1566-5e86-ab3b-58cffef08a4a
			column: Month

	partition Date = m
		mode: import
		source =
				let
				    StartDate = #date(1951, 1, 1),
				    EndDate = #date(2024, 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(Dates, Splitter.SplitByNothing(), type table [Date = date]),
				    AddYear = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
				    AddMonthNo = Table.AddColumn(AddYear, "Month Number", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], [Format = "MMM", Culture = "en-US"]), type text),
				    AddQuarter = Table.AddColumn(AddMonth, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    AddDecadeNo = Table.AddColumn(AddQuarter, "Decade Start", each Number.IntegerDivide(Date.Year([Date]), 10) * 10, Int64.Type),
				    AddDecade = Table.AddColumn(AddDecadeNo, "Decade", each Text.From([Decade Start]) & "s", type text),
				    AddDayOfYear = Table.AddColumn(AddDecade, "Day of Year", each Date.DayOfYear([Date]), Int64.Type),
				    AddYearMonth = Table.AddColumn(AddDayOfYear, "Month Start", each Date.StartOfMonth([Date]), type date)
				in
				    AddYearMonth


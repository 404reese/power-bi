	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 7335d1a9-373f-53ea-a272-46e11ffc0871
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: d7f5f839-8352-5442-b34b-7ee4a74863bf
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1a679f87-7085-5a89-bf11-af047ab8c026
		summarizeBy: none
		sourceColumn: Month Number

		annotation SummarizationSetBy = User

	column Month
		dataType: string
		lineageTag: 8c6fbb75-89a7-5006-957b-685ff869d96e

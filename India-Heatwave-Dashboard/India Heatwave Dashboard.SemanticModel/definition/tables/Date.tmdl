	column 'Decade Start'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7eaa2eaa-98dc-5d95-8cda-d8b973c2d993
		summarizeBy: none
		sourceColumn: Decade Start

		annotation SummarizationSetBy = User

	column Decade
		dataType: string
		lineageTag: a84f119d-c8fe-5355-be46-bc92f92acfc3
		summarizeBy: none
		sourceColumn: Decade
		sortByColumn: 'Decade Start'

		annotation SummarizationSetBy = User

	column 'Day of Year'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0e3be719-feba-5982-bad4-21cc8088d538
		summarizeBy: none
		sourceColumn: Day of Year


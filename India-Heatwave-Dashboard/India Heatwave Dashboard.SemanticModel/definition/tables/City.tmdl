	column Location
		dataType: string
		lineageTag: a6effc96-fd55-527e-a55d-f819ce542bc0
		dataCategory: Place
		summarizeBy: none
		sourceColumn: Location

		annotation SummarizationSetBy = User

	/// IMD-style region derived from latitude/longitude.
	column Region =
			SWITCH (
			    TRUE (),
			    'City'[Latitude] > 30, "Hilly Region",
			    'City'[Longitude] < 74 && 'City'[Latitude] < 20, "Coastal West",
			    'City'[Longitude] > 85, "East Plains",
			    'City'[Latitude] > 23, "North Plains",
			    'City'[Latitude] <= 23, "South Peninsula",
			    "Other"
			)
		lineageTag: 1cef9b68-3e09-5d28-bc9b-ba40e41ec211
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Terrain class that sets the IMD heatwave threshold (Plains 40, Coastal 37, Hilly 30).
	column Terrain =
			SWITCH (
			    'City'[Region],
			    "Hilly Region", "Hilly",
			    "Coastal West", "Coastal",
			    "Coastal East", "Coastal",
			    "Plains"
			)
		lineageTag: a5671ba5-b8ce-57dd-9242-1cbb6949c285
		summarizeBy: none

		annotation SummarizationSetBy = User

	hierarchy 'Region Hierarchy'
		lineageTag: 00aa35e8-7c22-5c60-8300-9bf80c79073c

		level Region
			lineageTag: fd38f2f9-4e2d-526e-b5d0-618f946a7c1e
			column: Region

		level City
			lineageTag: 044ac6c2-dc90-51f2-8d42-5615580753db
			column: City

	partition City = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [City = text, State = text, Latitude = number, Longitude = number, Location = text],
				        {
				            {"Delhi", "Delhi", 28.6139, 77.2090, "New Delhi, Delhi, India"},
				            {"Mumbai", "Maharashtra", 19.0760, 72.8777, "Mumbai, Maharashtra, India"},
				            {"Kolkata", "West Bengal", 22.5726, 88.3639, "Kolkata, West Bengal, India"},
				            {"Bangalore", "Karnataka", 12.9716, 77.5946, "Bengaluru, Karnataka, India"}
				        }
				    )
				in
				    Source


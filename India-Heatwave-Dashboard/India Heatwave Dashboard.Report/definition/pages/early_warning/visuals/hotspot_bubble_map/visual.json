{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "hotspot_bubble_map",
  "position": {
    "x": 748,
    "y": 394,
    "z": 6000,
    "height": 310,
    "width": 516,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "map",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "City"
                    }
                  },
                  "Property": "Location"
                }
              },
              "queryRef": "City.Location",
              "nativeQueryRef": "Location",
              "active": true
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "WeatherData"
                    }
                  },
                  "Property": "Heatwave Days"
                }
              },
              "queryRef": "WeatherData.Heatwave Days",
              "nativeQueryRef": "Heatwave Days"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "WeatherData"
                    }
                  },
                  "Property": "Severe Heatwave Days"
                }
              },
              "queryRef": "WeatherData.Severe Heatwave Days",
              "nativeQueryRef": "Severe Heatwave Days"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "WeatherData"
                    }
                  },
                  "Property": "Highest Max Temp"
                }
              },
              "queryRef": "WeatherData.Highest Max Temp",
              "nativeQueryRef": "Highest Max Temp"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#D03B3B'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Heatwave hotspots (bubble size = heatwave days)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
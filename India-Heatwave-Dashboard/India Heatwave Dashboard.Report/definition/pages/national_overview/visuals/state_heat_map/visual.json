{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "state_heat_map",
  "position": {
    "x": 16,
    "y": 188,
    "z": 8000,
    "height": 516,
    "width": 616,
    "tabOrder": 7
  },
  "visual": {
    "visualType": "filledMap",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "City"
                    }
                  },
                  "Property": "State"
                }
              },
              "queryRef": "City.State",
              "nativeQueryRef": "State",
              "active": true
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "WeatherData"
                    }
                  },
                  "Property": "Heatwave Days"
                }
              },
              "queryRef": "WeatherData.Heatwave Days",
              "nativeQueryRef": "Heatwave Days"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "WeatherData"
                    }
                  },
                  "Property": "Severe Heatwave Days"
                }
              },
              "queryRef": "WeatherData.Severe Heatwave Days",
              "nativeQueryRef": "Severe Heatwave Days"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "WeatherData"
                    }
                  },
                  "Property": "Highest Max Temp"
                }
              },
              "queryRef": "WeatherData.Highest Max Temp",
              "nativeQueryRef": "Highest Max Temp"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "FillRule": {
                      "Input": {
                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "WeatherData"
                            }
                          },
                          "Property": "Heatwave Days"
                        }
                      },
                      "FillRule": {
                        "linearGradient2": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#F6B99A'"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#B42318'"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'asZero'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Heatwave days by state (darker red = more heatwave days)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }

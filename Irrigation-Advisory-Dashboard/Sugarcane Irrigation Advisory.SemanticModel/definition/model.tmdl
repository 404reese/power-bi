model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","Farms"]

annotation PBI_ProTooling = ["DevMode"]

ref table Farms
ref table 'Forecast Rain'
ref table 'Pump Flow'
ref table 'Irrigation Efficiency'

ref role 'Malavalli Field Supervisor'
ref role 'Krishnarajpet Field Supervisor'

ref cultureInfo en-US


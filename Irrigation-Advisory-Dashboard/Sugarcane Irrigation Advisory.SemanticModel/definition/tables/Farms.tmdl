table Farms
	lineageTag: 9ac9f384-c27c-5e5c-a958-4d17fbd77664

	/// Number of geofenced plots.
	measure 'Farms Monitored' = DISTINCTCOUNT ( 'Farms'[Farm_ID] )
		formatString: #,##0
		displayFolder: 1. Overview
		lineageTag: 876b78bd-8a64-5906-b7f9-596d1bafb344

	/// Rows in the selection.
	measure 'Farm Count' = COUNTROWS ( 'Farms' )
		formatString: #,##0
		displayFolder: 1. Overview
		lineageTag: f035465d-1880-569e-a081-4f0d5701695e

	/// Plot centroid longitude.
	measure 'Plot Longitude' = AVERAGE ( 'Farms'[Longitude] )
		formatString: 0.0000
		displayFolder: 1. Overview
		lineageTag: b5ea6669-43ba-5c25-8a55-4b60cb001c89

	/// Plot centroid latitude.
	measure 'Plot Latitude' = AVERAGE ( 'Farms'[Latitude] )
		formatString: 0.0000
		displayFolder: 1. Overview
		lineageTag: 427bb0a0-f8cc-5188-b22d-e382e498d71a

	/// Total plot area.
	measure 'Total Area (ha)' = SUM ( 'Farms'[Farm_Area_ha] )
		formatString: #,##0.0
		displayFolder: 1. Overview
		lineageTag: aff7fffd-5edb-50d2-a6fd-eb77b5e66c30

	/// Average volumetric soil moisture.
	measure 'Avg Soil Moisture' = AVERAGE ( 'Farms'[Soil_Moisture] )
		formatString: 0.000" m³/m³"
		displayFolder: 2. Soil and Crop
		lineageTag: 65f91636-5d44-59fe-b0ab-df00ac235e6f

	/// Average available-water depletion.
	measure 'Avg Depletion %' = AVERAGE ( 'Farms'[Depletion %] )
		formatString: 0.0%
		displayFolder: 2. Soil and Crop
		lineageTag: c3033c63-790f-5398-a034-50b5bfd6d984

	/// Management allowed depletion (irrigate at this level).
	measure 'Irrigation Trigger' = 0.5
		formatString: 0%
		displayFolder: 2. Soil and Crop
		lineageTag: 07053719-d37d-59d2-abdf-415fd05e30ad

	/// Average NDVI (crop vigour).
	measure 'Avg NDVI' = AVERAGE ( 'Farms'[NDVI] )
		formatString: 0.000
		displayFolder: 2. Soil and Crop
		lineageTag: 60362516-2504-5109-b002-61c493157691

	/// Average leaf area index.
	measure 'Avg LAI' = AVERAGE ( 'Farms'[LAI] )
		formatString: 0.00
		displayFolder: 2. Soil and Crop
		lineageTag: a9b17451-1cf3-5769-b30c-05987d988f94

	/// Average soil pH.
	measure 'Avg Soil pH' = AVERAGE ( 'Farms'[Soil_pH] )
		formatString: 0.00
		displayFolder: 2. Soil and Crop
		lineageTag: 4c2e2f2f-1901-5f90-9763-b9832bc57190

	/// Average soil organic carbon (dataset units).
	measure 'Avg Organic Carbon' = AVERAGE ( 'Farms'[Organic_Carbon] )
		formatString: 0.0
		displayFolder: 2. Soil and Crop
		lineageTag: c7a4582d-4751-5713-a4d8-e24f7d76f35b

	/// Average 0-100 water stress score.
	measure 'Avg Water Stress Score' = AVERAGE ( 'Farms'[Water Stress Score] )
		formatString: 0.0
		displayFolder: 2. Soil and Crop
		lineageTag: 6165c0c2-4105-5643-97d7-e259835b272d

	/// Plots with a stress score of 60 or more.
	measure 'High Stress Farms' = CALCULATE ( COUNTROWS ( 'Farms' ), KEEPFILTERS ( 'Farms'[Stress Level] = "High" ) ) + 0
		formatString: #,##0
		displayFolder: 2. Soil and Crop
		lineageTag: bf722e78-1b59-5c60-ab42-0b3ad1ad382b

	/// Average seasonal rainfall.
	measure 'Avg Rainfall' = AVERAGE ( 'Farms'[Rainfall_mm] )
		formatString: #,##0" mm"
		displayFolder: 3. Weather
		lineageTag: d30dd4ef-e3c9-5543-882c-ff0ff795aff6

	/// Average air temperature.
	measure 'Avg Temperature' = AVERAGE ( 'Farms'[Temperature_C] )
		formatString: 0.0" °C"
		displayFolder: 3. Weather
		lineageTag: a339083f-1094-580a-b482-718301b0da36

	/// Average relative humidity.
	measure 'Avg Humidity' = AVERAGE ( 'Farms'[Relative_Humidity] )
		formatString: 0.0"%"
		displayFolder: 3. Weather
		lineageTag: 355deeed-301a-5355-b24c-75167a7efd62

	/// Average vapour pressure deficit.
	measure 'Avg VPD' = AVERAGE ( 'Farms'[VPD (kPa)] )
		formatString: 0.00" kPa"
		displayFolder: 3. Weather
		lineageTag: eb91c554-6e8c-5f3b-ba4f-6b0f5a4a5a93

	/// Average sugarcane ETc.
	measure 'Avg Crop Water Use' = AVERAGE ( 'Farms'[ETc (mm/day)] )
		formatString: 0.00" mm/day"
		displayFolder: 3. Weather
		lineageTag: cbc51230-2308-5b4f-90e7-54df88aef43d

	/// Plots that have crossed the irrigation trigger.
	measure 'Farms to Irrigate Today' = CALCULATE ( COUNTROWS ( 'Farms' ), KEEPFILTERS ( 'Farms'[Advisory Category] = "Irrigate Today" ) ) + 0
		formatString: #,##0
		displayFolder: 4. Advisory
		lineageTag: 5bdce3c9-8a66-5522-b23d-40cbaa749889

	/// Share of plots to irrigate today.
	measure '% Farms to Irrigate Today' = DIVIDE ( [Farms to Irrigate Today], [Farm Count] )
		formatString: 0.0%
		displayFolder: 4. Advisory
		lineageTag: e77cd64c-c9b1-51b6-b116-6b81e94d3ba4

	/// Water to apply today on plots that are due.
	measure 'Water Required Today (m3)' = CALCULATE ( SUM ( 'Farms'[Irrigation Volume (m3)] ), KEEPFILTERS ( 'Farms'[Advisory Category] = "Irrigate Today" ) ) + 0
		formatString: #,##0" m³"
		displayFolder: 4. Advisory
		lineageTag: 9e41e732-60d0-57d9-87dc-b12ce2bf6cf7

	/// Total pump hours needed today.
	measure 'Pump Hours Today' = CALCULATE ( SUM ( 'Farms'[Pump Hours] ), KEEPFILTERS ( 'Farms'[Advisory Category] = "Irrigate Today" ) ) + 0
		formatString: #,##0
		displayFolder: 4. Advisory
		lineageTag: eca35f4e-d214-5669-ace3-c94afe10eb2e

	/// Electricity needed today.
	measure 'Energy Today (kWh)' = CALCULATE ( SUM ( 'Farms'[Energy (kWh)] ), KEEPFILTERS ( 'Farms'[Advisory Category] = "Irrigate Today" ) ) + 0
		formatString: #,##0" kWh"
		displayFolder: 4. Advisory
		lineageTag: f476eaf8-98b0-5297-a671-bb0bbf2b8529

	/// Average days until the next irrigation is due.
	measure 'Avg Days to Next Irrigation' = AVERAGE ( 'Farms'[Days to Next Irrigation] )
		formatString: 0.0
		displayFolder: 4. Advisory
		lineageTag: 6d1ab725-d1fb-5ed5-aaf9-f0fb2827275b

	/// Average yield loss risk if irrigation is delayed by 3 days.
	measure 'Avg Yield Loss Risk' = AVERAGE ( 'Farms'[Yield Loss Risk if Delayed 3 Days] )
		formatString: 0.0%
		displayFolder: 4. Advisory
		lineageTag: 830a46b8-ce26-51f6-b3f9-6358468128ff

	/// Water used if every plot gets the usual 100 mm flood irrigation.
	measure 'Farmer Practice Water (m3)' = SUM ( 'Farms'[Farmer Practice Volume (m3)] )
		formatString: #,##0" m³"
		displayFolder: 4. Advisory
		lineageTag: 0bd53560-8a03-5cc6-96de-f028e25d108f

	/// Water saved by irrigating only the plots that need it, by the amount they need.
	measure 'Water Saved (m3)' = [Farmer Practice Water (m3)] - [Water Required Today (m3)]
		formatString: #,##0" m³"
		displayFolder: 4. Advisory
		lineageTag: 7b4990d1-60ee-58aa-b0cb-78982e0246e3

	/// Water saved as a share of the farmer practice.
	measure 'Water Saved %' = DIVIDE ( [Water Saved (m3)], [Farmer Practice Water (m3)] )
		formatString: 0.0%
		displayFolder: 4. Advisory
		lineageTag: f98578a0-a636-50e4-ae61-cef18c5b3cc1

	/// Background colour for the advisory column.
	measure 'Advisory Color' =
			SWITCH (
			    SELECTEDVALUE ( 'Farms'[Advisory Category] ),
			    "Irrigate Today", "#F4B4B4",
			    "Irrigate in 1-3 Days", "#F8D0BC",
			    "Irrigate in 4-7 Days", "#FCE5A8",
			    "No Irrigation Needed", "#BFE8BF",
			    "#FFFFFF"
			)
		displayFolder: 4. Advisory
		lineageTag: b90546e9-aedf-5231-b373-b531aa9d960e

	/// Farmer-friendly advisory text (LLM-style template).
	measure Advisory =
			VAR IsOneFarm = HASONEVALUE ( 'Farms'[Farm_ID] )
			VAR Cat = SELECTEDVALUE ( 'Farms'[Advisory Category] )
			VAR Hrs = SUM ( 'Farms'[Pump Hours] )
			VAR Vol = SUM ( 'Farms'[Irrigation Volume (m3)] )
			VAR Dep = AVERAGE ( 'Farms'[Depletion %] )
			VAR Days = AVERAGE ( 'Farms'[Days to Next Irrigation] )
			VAR Slots = SUM ( 'Farms'[Power Slots (7 h)] )
			VAR Fert = SELECTEDVALUE ( 'Farms'[Fertigation Advice] )
			VAR Area = IF ( HASONEVALUE ( 'Farms'[Village] ), VALUES ( 'Farms'[Village] ), "the selected area" )
			RETURN
			    IF (
			        IsOneFarm,
			        SWITCH (
			            Cat,
			            "Irrigate Today",
			                "Irrigate today. Run the pump for about " & FORMAT ( Hrs, "0.0" ) & " hours (" & FORMAT ( Vol, "#,##0" )
			                    & " m³), split over " & Slots & " power slot(s), starting early morning. Soil moisture is "
			                    & FORMAT ( Dep, "0%" ) & " depleted. ",
			            "Irrigate in 1-3 Days",
			                "No irrigation today. Plan the next irrigation in about " & FORMAT ( ROUNDUP ( Days, 0 ), "0" )
			                    & " day(s); keep " & FORMAT ( Hrs, "0.0" ) & " pump hours ready. ",
			            "Irrigate in 4-7 Days",
			                "Soil moisture is adequate. Next irrigation in about " & FORMAT ( ROUNDUP ( Days, 0 ), "0" ) & " days. ",
			            "Soil moisture is sufficient. Irrigation is not required this week. "
			        ) & Fert,
			        FORMAT ( [Farms to Irrigate Today], "#,##0" ) & " of " & FORMAT ( [Farm Count], "#,##0" ) & " plots in " & Area
			            & " should be irrigated today, needing " & FORMAT ( [Water Required Today (m3)], "#,##0" ) & " m³ and "
			            & FORMAT ( [Pump Hours Today], "#,##0" ) & " pump hours. Average depletion is " & FORMAT ( [Avg Depletion %], "0%" )
			            & " against a " & FORMAT ( [Irrigation Trigger], "0%" ) & " trigger. Schedule pumps across the 7-hour power windows "
			            & "and prioritise plots marked High stress."
			    )
		displayFolder: 4. Advisory
		lineageTag: 9211ef0b-3c1b-5cdd-a41d-e55b3ac6c199

	/// Plots still needing irrigation after the forecast rain (80% effective).
	measure 'Scenario Farms to Irrigate' =
			VAR EffRain = 0.8 * [Forecast Rain Value]
			RETURN
			    SUMX ( 'Farms', IF ( 'Farms'[Root Zone Deficit (mm)] - EffRain >= 48.0, 1, 0 ) )
		formatString: #,##0
		displayFolder: 5. What-if
		lineageTag: 05991901-1044-50fb-a8e8-75bed1140b07

	/// Water needed under the scenario.
	measure 'Scenario Water (m3)' =
			VAR EffRain = 0.8 * [Forecast Rain Value]
			VAR Eff = [Irrigation Efficiency Value]
			RETURN
			    SUMX (
			        'Farms',
			        VAR NetMm = 'Farms'[Root Zone Deficit (mm)] - EffRain
			        RETURN
			            IF ( NetMm >= 48.0, NetMm / Eff * 'Farms'[Farm_Area_ha] * 10, 0 )
			    )
		formatString: #,##0" m³"
		displayFolder: 5. What-if
		lineageTag: 698bc3a2-5d36-58fa-bca6-56ccce2f596c

	/// Pump hours needed under the scenario.
	measure 'Scenario Pump Hours' = DIVIDE ( [Scenario Water (m3)], [Pump Flow Value] )
		formatString: #,##0
		displayFolder: 5. What-if
		lineageTag: f142a50b-b593-5bf8-87a5-856e30b0673e

	/// Electricity under the scenario.
	measure 'Scenario Energy (kWh)' = [Scenario Pump Hours] * 3.73
		formatString: #,##0" kWh"
		displayFolder: 5. What-if
		lineageTag: 2fdf62f8-0421-5b1e-8a03-282bf345b620

	/// Water saved vs farmer practice under the scenario.
	measure 'Scenario Water Saved %' = DIVIDE ( [Farmer Practice Water (m3)] - [Scenario Water (m3)], [Farmer Practice Water (m3)] )
		formatString: 0.0%
		displayFolder: 5. What-if
		lineageTag: eba36f7f-d187-5fef-ba48-7f941b4ab7b4


	/// Water needed to refill the 600 mm root zone to field capacity (0.3 m3/m3).
	column 'Root Zone Deficit (mm)' = MAX ( 0, ( 0.3 - 'Farms'[Soil_Moisture] ) * 600 )
		formatString: 0.0
		lineageTag: 828e4ad6-3ee7-524a-86a8-098fddd09e03
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Share of total available water (96.0 mm) already used by the crop.
	column 'Depletion %' = DIVIDE ( 'Farms'[Root Zone Deficit (mm)], 96.0 )
		formatString: 0.0%
		lineageTag: 18fdfa86-f488-5081-a738-25b9318cd9bf
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Vapour pressure deficit: how strongly the air pulls water from the crop.
	column 'VPD (kPa)' =
			VAR Tc = 'Farms'[Temperature_C]
			VAR Es = 0.6108 * EXP ( 17.27 * Tc / ( Tc + 237.3 ) )
			RETURN
			    Es * ( 1 - 'Farms'[Relative_Humidity] / 100 )
		formatString: 0.00
		lineageTag: 11442db0-7e64-580e-aac2-88bf8b88462a
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Reference evapotranspiration, Hargreaves (Ra 15 mm/day, diurnal range 10 C assumed).
	column 'ET0 (mm/day)' = 0.0023 * 15 * ( 'Farms'[Temperature_C] + 17.8 ) * SQRT ( 10 )
		formatString: 0.00
		lineageTag: b9905604-c6d6-5a1a-97da-b1f163a5f418
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Sugarcane crop water use at grand growth stage (Kc 1.25).
	column 'ETc (mm/day)' = 1.25 * 'Farms'[ET0 (mm/day)]
		formatString: 0.00
		lineageTag: 254e6499-a9d4-5a73-9017-e3ba12e87835
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Days until depletion reaches the 50% trigger (48.0 mm).
	column 'Days to Next Irrigation' = MAX ( 0, ( 48.0 - 'Farms'[Root Zone Deficit (mm)] ) / 'Farms'[ETc (mm/day)] )
		formatString: 0.0
		lineageTag: f1b12f07-287b-579a-a432-6bf7c99841d7
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Irrigation advisory for the plot.
	column 'Advisory Category' =
			SWITCH (
			    TRUE (),
			    'Farms'[Root Zone Deficit (mm)] >= 48.0, "Irrigate Today",
			    'Farms'[Days to Next Irrigation] <= 3, "Irrigate in 1-3 Days",
			    'Farms'[Days to Next Irrigation] <= 7, "Irrigate in 4-7 Days",
			    "No Irrigation Needed"
			)
		lineageTag: 245850f7-73db-5cae-8272-3c29d546dcb3
		summarizeBy: none
		sortByColumn: 'Advisory Order'

		annotation SummarizationSetBy = User

	column 'Advisory Order' =
			SWITCH (
			    TRUE (),
			    'Farms'[Root Zone Deficit (mm)] >= 48.0, 1,
			    'Farms'[Days to Next Irrigation] <= 3, 2,
			    'Farms'[Days to Next Irrigation] <= 7, 3,
			    4
			)
		isHidden
		formatString: 0
		lineageTag: ef953ef7-30c7-5be5-9994-7c5508c5a218
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// 0-100 index: 60% soil moisture depletion, 25% low NDVI, 15% atmospheric demand (VPD).
	column 'Water Stress Score' =
			VAR Moist = MIN ( 1, MAX ( 0, ( 'Farms'[Depletion %] - 0.2 ) / 0.4 ) )
			VAR Veg = MIN ( 1, MAX ( 0, ( 0.75 - 'Farms'[NDVI] ) / 0.4 ) )
			VAR Air = MIN ( 1, MAX ( 0, ( 'Farms'[VPD (kPa)] - 0.4 ) / 0.8 ) )
			RETURN
			    ROUND ( 100 * ( 0.60 * Moist + 0.25 * Veg + 0.15 * Air ), 1 )
		formatString: 0.0
		lineageTag: c579143f-2b40-5d22-bf44-23d22f5b2fef
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Stress band from the Water Stress Score.
	column 'Stress Level' =
			SWITCH (
			    TRUE (),
			    'Farms'[Water Stress Score] >= 60, "High",
			    'Farms'[Water Stress Score] >= 40, "Moderate",
			    "Low"
			)
		lineageTag: 8f4f4742-cb33-5aaf-ac79-950a862a8567
		summarizeBy: none
		sortByColumn: 'Stress Order'

		annotation SummarizationSetBy = User

	column 'Stress Order' =
			SWITCH (
			    TRUE (),
			    'Farms'[Water Stress Score] >= 60, 1,
			    'Farms'[Water Stress Score] >= 40, 2,
			    3
			)
		isHidden
		formatString: 0
		lineageTag: 02985bc4-88bc-574e-9115-ab81f44f58ba
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Depth to apply at 60% furrow application efficiency.
	column 'Gross Irrigation (mm)' = 'Farms'[Root Zone Deficit (mm)] / 0.6
		formatString: 0.0
		lineageTag: b3237095-91b6-582c-9454-f335a10cc1c2
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Water to apply on the plot (1 mm over 1 ha = 10 m3).
	column 'Irrigation Volume (m3)' = 'Farms'[Gross Irrigation (mm)] * 'Farms'[Farm_Area_ha] * 10
		formatString: #,##0
		lineageTag: b3b6a265-b179-551a-9d08-c3e76023a5ff
		summarizeBy: sum

		annotation SummarizationSetBy = User

	/// Run time of a 30 m3/h pump.
	column 'Pump Hours' = 'Farms'[Irrigation Volume (m3)] / 30
		formatString: 0.0
		lineageTag: 5f888282-cddd-5509-a2ee-065dc235549e
		summarizeBy: sum

		annotation SummarizationSetBy = User

	/// Number of 7-hour daily 3-phase power windows needed to finish the irrigation.
	column 'Power Slots (7 h)' = ROUNDUP ( 'Farms'[Pump Hours] / 7, 0 )
		formatString: 0
		lineageTag: 64380f7d-c921-5735-9d35-de56073ac333
		summarizeBy: sum

		annotation SummarizationSetBy = User

	/// Electricity used by a 5 HP pump.
	column 'Energy (kWh)' = 'Farms'[Pump Hours] * 3.73
		formatString: #,##0
		lineageTag: 1189f67a-084d-57b3-b929-012eda7952f9
		summarizeBy: sum

		annotation SummarizationSetBy = User

	/// Relative yield reduction during the stress period (FAO-33, sugarcane Ky 1.2).
	column 'Yield Loss Risk if Delayed 3 Days' =
			VAR Dr3 = 'Farms'[Root Zone Deficit (mm)] + 3 * 'Farms'[ETc (mm/day)]
			VAR Ks =
			    IF ( Dr3 > 48.0, MAX ( 0, ( 96.0 - Dr3 ) / ( ( 1 - 0.5 ) * 96.0 ) ), 1 )
			RETURN
			    1.2 * ( 1 - Ks )
		formatString: 0.0%
		lineageTag: 13956578-82bf-57cc-b4c8-ce536d18860a
		summarizeBy: average

		annotation SummarizationSetBy = User

	/// Water used by the usual fixed 100 mm flood irrigation on every plot.
	column 'Farmer Practice Volume (m3)' = 100 * 'Farms'[Farm_Area_ha] * 10
		formatString: #,##0
		lineageTag: 93a43069-88a0-59c2-928f-2c74be8d55fb
		summarizeBy: sum

		annotation SummarizationSetBy = User

	/// Crop vigour band from NDVI.
	column 'NDVI Class' =
			SWITCH (
			    TRUE (),
			    'Farms'[NDVI] < 0.4, "Poor Vigour",
			    'Farms'[NDVI] < 0.6, "Moderate Vigour",
			    "Healthy Vigour"
			)
		lineageTag: efa2c4a6-609b-5ab0-8ab1-93c6a4cdaf86
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Soil reaction class.
	column 'pH Class' =
			SWITCH (
			    TRUE (),
			    'Farms'[Soil_pH] < 6.5, "Slightly Acidic",
			    'Farms'[Soil_pH] <= 7.5, "Neutral",
			    "Alkaline"
			)
		lineageTag: dd325b4a-685c-5981-bf9d-45dccc003823
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Seasonal rainfall band.
	column 'Rainfall Zone' =
			SWITCH (
			    TRUE (),
			    'Farms'[Rainfall_mm] < 550, "Low (<550 mm)",
			    'Farms'[Rainfall_mm] < 650, "Medium (550-650 mm)",
			    "High (650 mm+)"
			)
		lineageTag: 40cf4118-e95b-502a-a2c6-6384bbad2825
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Rule-based fertigation recommendation.
	column 'Fertigation Advice' =
			SWITCH (
			    TRUE (),
			    'Farms'[NDVI] < 0.45, "Low vigour: test leaf N, give a split nitrogen dose through drip/furrow with the next irrigation.",
			    'Farms'[Soil_pH] < 6.2, "Acidic soil: apply lime as per soil test, avoid ammonium sulphate.",
			    'Farms'[Soil_pH] > 7.5, "Alkaline soil: prefer acid-forming fertilisers and add gypsum.",
			    "Normal vigour: continue the scheduled NPK fertigation."
			)
		lineageTag: d8fdaef9-d8b2-5bb8-a03c-8d2e3ecb0deb
		summarizeBy: none

		annotation SummarizationSetBy = User

	hierarchy 'Location Hierarchy'
		lineageTag: 46c2eb97-55b7-583a-b485-fb298802c8c2

		level District
			lineageTag: 33ab0535-63ec-5746-b95a-7a26907b060f
			column: District

		level Taluk
			lineageTag: 22ddec07-b585-5654-a818-53256da6f2dd
			column: Taluk

		level Village
			lineageTag: b11e4379-74a2-58f1-b541-c29e0b9e9642
			column: Village

		level Farm_ID
			lineageTag: 353cccbe-16cb-5d2e-8ea2-f313ea3c6536
			column: Farm_ID

	partition Farms = m
		mode: import
		source =
				let
				    // ---------- 1. Import the satellite / sensor extract (one row per geofenced sugarcane plot) ----------
				    // Power Query has no relative paths, so: read Data\IrrigationAdvisoryDataset.csv from the DataFolder parameter,
				    // and if that path does not exist on this PC, fall back to a compressed copy of the same CSV stored in the model.
				    EmbeddedCsv = Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate),
				    FileCsv = try Binary.Buffer(File.Contents(DataFolder & "IrrigationAdvisoryDataset.csv")) otherwise null,
				    CsvBinary = if FileCsv = null then EmbeddedCsv else FileCsv,
				    Source = Csv.Document(
				        CsvBinary,
				        [Delimiter = ",", Columns = 16, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"system:index", "RecordID"}, {".geo", "Geometry"}}),
				
				    // ---------- 2. Clean text keys ----------
				    Trimmed = Table.TransformColumns(Renamed, {
				        {"Farm_ID", each Text.Upper(Text.Trim(_)), type text},
				        {"District", Text.Trim, type text},
				        {"Taluk", Text.Trim, type text},
				        {"Village", Text.Trim, type text}}),
				    NoBlankIds = Table.SelectRows(Trimmed, each [Farm_ID] <> null and [Farm_ID] <> ""),
				    NoDuplicates = Table.Distinct(NoBlankIds, {"Farm_ID"}),
				
				    // ---------- 3. Set numeric types (Google Earth Engine export uses "." decimals) ----------
				    ToNum = (v as any) as nullable number =>
				        if v = null then null
				        else let s = Text.Trim(Text.From(v)) in if s = "" then null else try Number.FromText(s, "en-US") otherwise null,
				    NumCols = {"Farm_Area_ha", "LAI", "NDVI", "Organic_Carbon", "Rainfall_mm", "Relative_Humidity",
				               "Soil_Moisture", "Soil_pH", "Temperature_C"},
				    Numbers = Table.TransformColumns(NoDuplicates, List.Transform(NumCols, (c) => {c, ToNum, type nullable number})),
				
				    // ---------- 4. Range checks: physically impossible sensor values become null ----------
				    RangeChecked = Table.TransformColumns(Numbers, {
				        {"NDVI", each if _ = null or _ < -1 or _ > 1 then null else _, type nullable number},
				        {"Soil_Moisture", each if _ = null or _ <= 0 or _ > 0.6 then null else _, type nullable number},
				        {"Soil_pH", each if _ = null or _ < 3 or _ > 10 then null else _, type nullable number},
				        {"Relative_Humidity", each if _ = null or _ < 0 or _ > 100 then null else _, type nullable number},
				        {"LAI", each if _ = null or _ < 0 or _ > 10 then null else _, type nullable number}}),
				
				    // ---------- 5. Impute missing NDVI (cloud-masked pixels) with the village median ----------
				    VillageMedians = Table.Group(RangeChecked, {"Village"},
				        {{"VillageNDVI", each List.Median(List.RemoveNulls([NDVI])), type nullable number}}),
				    WithMedian = Table.NestedJoin(RangeChecked, {"Village"}, VillageMedians, {"Village"}, "VM", JoinKind.LeftOuter),
				    ExpandMedian = Table.ExpandTableColumn(WithMedian, "VM", {"VillageNDVI"}),
				    NDVIFlag = Table.AddColumn(ExpandMedian, "NDVI_Imputed", each [NDVI] = null, type logical),
				    NDVIFilled = Table.AddColumn(NDVIFlag, "NDVI_Clean", each if [NDVI] = null then [VillageNDVI] else [NDVI], type nullable number),
				
				    // ---------- 6. Plot centroid from the GeoJSON polygon (geofence) ----------
				    Centroid = Table.AddColumn(NDVIFilled, "Centroid", each
				        try
				            let
				                Ring = List.RemoveLastN(Json.Document([Geometry])[coordinates]{0}, 1)
				            in
				                [Longitude = List.Average(List.Transform(Ring, (p) => p{0})),
				                 Latitude = List.Average(List.Transform(Ring, (p) => p{1}))]
				        otherwise [Longitude = null, Latitude = null]),
				    WithCoords = Table.ExpandRecordColumn(Centroid, "Centroid", {"Longitude", "Latitude"}),
				
				    // ---------- 7. Location text for map geocoding and final shape ----------
				    WithLocation = Table.AddColumn(WithCoords, "Village Location",
				        each [Village] & ", " & [Taluk] & ", Mandya, Karnataka, India", type text),
				    Selected = Table.SelectColumns(WithLocation, {
				        "Farm_ID", "District", "Taluk", "Village", "Village Location", "Farm_Area_ha",
				        "Soil_Moisture", "NDVI_Clean", "NDVI_Imputed", "LAI", "Soil_pH", "Organic_Carbon",
				        "Rainfall_mm", "Temperature_C", "Relative_Humidity", "Latitude", "Longitude"}),
				    Final = Table.RenameColumns(Selected, {{"NDVI_Clean", "NDVI"}}),
				    Typed = Table.TransformColumnTypes(Final, {
				        {"Farm_ID", type text}, {"District", type text}, {"Taluk", type text}, {"Village", type text},
				        {"Village Location", type text}, {"Farm_Area_ha", type number}, {"Soil_Moisture", type number},
				        {"NDVI", type number}, {"NDVI_Imputed", type logical}, {"LAI", type number}, {"Soil_pH", type number},
				        {"Organic_Carbon", type number}, {"Rainfall_mm", type number}, {"Temperature_C", type number},
				        {"Relative_Humidity", type number}, {"Latitude", type number}, {"Longitude", type number}})
				in
				    Typed

